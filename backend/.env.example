# Copia este archivo como backend/.env y completa los valores. Nunca subas .env al repositorio.

# --- Base de datos MySQL 8 ---
DB_URL=jdbc:mysql://localhost:3306/sammy_gym?createDatabaseIfNotExist=true&serverTimezone=America/Lima&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=cambia_esto

# --- Aplicación ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
JPA_DDL_AUTO=update

# --- Seguridad ---
# Clave para firmar los JWT: mínimo 32 caracteres aleatorios.
# Puedes generarla en PowerShell con:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria_de_32+_caracteres
# Duración del token en milisegundos (28800000 = 8 horas)
JWT_EXPIRATION_MS=28800000
# Origen permitido por CORS (URL del frontend Angular)
FRONTEND_URL=http://localhost:4200

# Contraseña de los usuarios FICTICIOS creados por el DataSeeder (solo perfil dev)
SEED_PASSWORD=cambia_esto
