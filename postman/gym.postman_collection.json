    {
      "name": "PE-05 POST /api/clases como entrenador → 201",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Clase dentro de 2 días, en una hora aleatoria (06:00–21:00) para no chocar con ejecuciones anteriores",
              "const pad = n => String(n).padStart(2, '0');",
              "const d = new Date();",
              "d.setDate(d.getDate() + 2);",
              "const h = 6 + Math.floor(Math.random() * 16);",
              "const m = [0, 10, 20, 30][Math.floor(Math.random() * 4)];",
              "pm.variables.set('fechaClase', `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`);",
              "pm.variables.set('horaInicio', `${pad(h)}:${pad(m)}`);",
              "pm.variables.set('horaFin', `${pad(h)}:${pad(m + 25)}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('PE-05: status 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Devuelve la clase creada con cupos', () => {",
              "  pm.expect(body.id).to.be.a('number');",
              "  pm.expect(body.aforoMaximo).to.eql(1);",
              "  pm.expect(body.cuposDisponibles).to.eql(1);",
              "});",
              "pm.test('Cabecera Location', () => pm.response.to.have.header('Location'));",
              "pm.collectionVariables.set('claseId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Funcional Express (Postman)\",\n  \"disciplina\": \"FUNCIONAL\",\n  \"fecha\": \"{{fechaClase}}\",\n  \"horaInicio\": \"{{horaInicio}}\",\n  \"horaFin\": \"{{horaFin}}\",\n  \"aforoMaximo\": 1,\n  \"descripcion\": \"Clase creada por la colección de pruebas\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/clases", "host": ["{{baseUrl}}"], "path": ["api", "clases"] },
        "description": "El entrenador crea una clase para sí mismo (no envía entrenadorId). Aforo 1 para poder probar PE-07."
      }
    },
